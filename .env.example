# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="file:./dev.db"                           # SQLite для dev
DATABASE_URL_PROD="mysql://user:password@localhost:3306/village_news"  # MySQL для prod

# JWT
JWT_ACCESS_SECRET=your_very_strong_access_secret_here_change_in_prod
JWT_REFRESH_SECRET=your_very_strong_refresh_secret_here_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=localhost                                # в prod — твой домен
COOKIE_SECURE=false                                    # true в prod (HTTPS)
COOKIE_SAMESITE=lax

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760                               # 10MB по умолчанию
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Future-proof variables (может понадобиться позже)
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100